{
  "id": "planar-cap-v1",
  "description": "Planar BC cap contour methods on index 119 (audit-only; caps not assembled onto skin).",
  "indices_file": "batch/validation_indices.txt",
  "recipes": [
    {
      "recipe_cli": "upsample_blur",
      "base_recipe": "planar_cap_contour",
      "cli_args": ["--bc-planar-cap-method", "upsample_blur", "--on-bc-fail", "warn"],
      "tag": "cap-default",
      "role": "upsample_blur planar cap contour (preferred)"
    },
    {
      "recipe_cli": "native_contour",
      "base_recipe": "planar_cap_contour",
      "cli_args": ["--bc-planar-cap-method", "native_contour", "--on-bc-fail", "warn"],
      "tag": "cap-native",
      "role": "native_contour (stairstep reference)"
    },
    {
      "recipe_cli": "laplacian_monolithic",
      "base_recipe": "pyvista_laplacian",
      "cli_args": [],
      "tag": "monolithic",
      "role": "Monolithic MC BC faces + Laplacian (no planar cap stage)"
    }
  ],
  "smoothness_metrics": {
    "axis_aligned_edge_frac": "Free-free axis-aligned edge fraction",
    "free_dihedral_p95_deg": "Free boundary dihedral p95"
  },
  "hard_gates": {
    "bc_plane_max_residual": 1e-5,
    "planar_cap_containment_ok": 1
  },
  "soft_gates": {
    "vf_tol_cells": 2.0
  }
}
